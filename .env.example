# Copy to .env and fill in. Never commit .env.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM providers (leave blank to use only the fake provider) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
GEMINI_CHAT_MODEL=gemini-2.5-flash
DEFAULT_LLM_PROVIDER=fake
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
# Optional; only sent to providers/models that accept it (leave unset for reasoning models)
CHAT_TEMPERATURE=

# --- Retrieval / chat ---
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.2
CHAT_HISTORY_TURNS=4

# --- Contract review agent ---
MAX_AGENT_STEPS=25
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_CLAUSES=30

# --- Observability ---
# Editable price table for cost estimates (defaults to backend/config/pricing.yaml)
# PRICING_FILE=/app/config/pricing.yaml

# --- Embeddings ---
# "openai" (needs OPENAI_API_KEY) or "fake" (offline, deterministic; fine for local dev and tests)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Postgres (pgvector) ---
POSTGRES_USER=policypilot
POSTGRES_PASSWORD=policypilot
POSTGRES_DB=policypilot
POSTGRES_PORT=5432
# Used when running the backend on the host; docker compose overrides it to use the "postgres" host.
DATABASE_URL=postgresql+asyncpg://policypilot:policypilot@localhost:5432/policypilot

# --- MongoDB ---
MONGO_PORT=27017
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=policypilot

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
