# Copy to .env and fill in. Never commit .env.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM providers (leave blank to use only the fake provider) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
GEMINI_CHAT_MODEL=gemini-2.5-flash
DEFAULT_LLM_PROVIDER=fake

# --- Embeddings ---
# "openai" (needs OPENAI_API_KEY) or "fake" (offline, deterministic; fine for local dev and tests)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Postgres (pgvector) ---
POSTGRES_USER=policypilot
POSTGRES_PASSWORD=policypilot
POSTGRES_DB=policypilot
POSTGRES_PORT=5432
# Used when running the backend on the host; docker compose overrides it to use the "postgres" host.
DATABASE_URL=postgresql+asyncpg://policypilot:policypilot@localhost:5432/policypilot

# --- MongoDB ---
MONGO_PORT=27017
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=policypilot

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
